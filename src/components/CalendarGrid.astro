---
/*
 * The year as 12 month strips over the reference leap year: rows are months,
 * columns are days 1–31 (transposed with CSS on narrow screens, same DOM).
 * Cells go from blue to mustard by number of songs. Everything renders at
 * build time; the <script> below only adds the shared tooltip, click →
 * `mdm:search`, and the `.is-target` highlight on `mdm:result`.
 */
import db from '../data/songs.json';
import { cellLabel, levelFor, monthAbbr, monthStrips } from '../lib/calendar';
import type { DB } from '../lib/types';

const data = db as DB;

type Item =
  | { kind: 'month'; abbr: string }
  | { kind: 'day'; md: string; level: number; label: string }
  | { kind: 'void' };

// Flat, month-major: [label, day 1 … day 31] × 12.
const rows: Item[] = monthStrips().flatMap(({ month, days }): Item[] => [
  { kind: 'month', abbr: monthAbbr(month) },
  ...days.map((cell): Item => {
    if (!cell) return { kind: 'void' };
    const count = data.days[cell.md]?.length ?? 0;
    return { kind: 'day', md: cell.md, level: levelFor(count), label: cellLabel(cell.md, count) };
  }),
]);
const AXIS = new Set([1, 5, 10, 15, 20, 25, 31]);
const axis = Array.from({ length: 31 }, (_, i) => (AXIS.has(i + 1) ? String(i + 1) : ''));
---

<section id="calendar" class="cal" aria-labelledby="cal-title">
  <div class="cal__intro">
    <h2 id="cal-title" class="cal__title">Todo el año</h2>
    <p class="lede">Tocá un cuadradito para ver las canciones que hay ese día.</p>
  </div>

  <div class="cal__panel">
    <!--
      13 groups of 32 items: the day axis first, then one per month (label + 31 slots).
      Desktop flows them as rows; mobile flows the same items as columns.
    -->
    <div class="strips" id="cal-grid">
      <span class="strips__corner" aria-hidden="true"></span>
      {axis.map((n) => <span class="strips__axis" aria-hidden="true">{n}</span>)}
      {
        rows.map((item) =>
          item.kind === 'month' ? (
            <span class="strips__month" aria-hidden="true">{item.abbr}</span>
          ) : item.kind === 'day' ? (
            <button type="button" class="cell" data-md={item.md} data-level={item.level} aria-label={item.label} />
          ) : (
            <span class="cell cell--void" aria-hidden="true" />
          ),
        )
      }
    </div>

    <div class="cal__legend" aria-hidden="true">
      <span>menos</span>
      {[0, 1, 2, 3, 4].map((level) => <span class="cell cell--swatch" data-level={level} />)}
      <span>más</span>
    </div>
  </div>

  <div class="cal-tip" id="cal-tip" role="tooltip" hidden>
    <p class="cal-tip__head"><span class="cal-tip__date"></span><span class="cal-tip__count"></span></p>
    <ul class="cal-tip__list"></ul>
    <p class="cal-tip__hint"></p>
  </div>
</section>

<script>
  import { countLabel } from '../lib/calendar';
  import { spokenDate } from '../lib/format';
  import { parseHash, toMd } from '../lib/nearest';
  import type { DB } from '../lib/types';

  const MAX_TITLES = 4;
  const EDGE = 8; // min distance from the viewport edge
  const GAP = 10; // distance between cell and tooltip

  const grid = document.getElementById('cal-grid');
  const tip = document.getElementById('cal-tip');
  const dbNode = document.getElementById('db');

  if (grid && tip && dbNode) {
    const db = JSON.parse(dbNode.textContent ?? '{}') as DB;
    const tipDate = tip.querySelector<HTMLElement>('.cal-tip__date')!;
    const tipCount = tip.querySelector<HTMLElement>('.cal-tip__count')!;
    const tipList = tip.querySelector<HTMLUListElement>('.cal-tip__list')!;
    const tipHint = tip.querySelector<HTMLElement>('.cal-tip__hint')!;

    const cellFrom = (node: EventTarget | null): HTMLButtonElement | null =>
      node instanceof Element ? node.closest<HTMLButtonElement>('button.cell[data-md]') : null;

    /* ---------- tooltip ---------- */

    let tipFor: HTMLButtonElement | null = null;

    function fillTip(md: string): void {
      const titles = (db.days?.[md] ?? []).map((i) => db.songs[i]?.title).filter(Boolean) as string[];
      tipDate.textContent = spokenDate(md);
      tipCount.textContent = countLabel(titles.length);
      tipList.replaceChildren(
        ...titles.slice(0, MAX_TITLES).map((title) => {
          const li = document.createElement('li');
          li.textContent = title;
          return li;
        }),
      );
      tipList.hidden = titles.length === 0;
      const extra = titles.length - MAX_TITLES;
      tipHint.textContent =
        titles.length === 0 ? 'tocá para ver la más cercana' : extra > 0 ? `y ${extra} más · tocá para verlas` : '';
      tipHint.hidden = tipHint.textContent === '';
    }

    function placeTip(cell: HTMLElement): void {
      const r = cell.getBoundingClientRect();
      const vw = document.documentElement.clientWidth;
      const vh = window.innerHeight;
      const { width, height } = tip!.getBoundingClientRect();
      let left = r.left + r.width / 2 - width / 2;
      left = Math.max(EDGE, Math.min(left, vw - width - EDGE));
      let top = r.top - height - GAP;
      if (top < EDGE) top = Math.min(r.bottom + GAP, vh - height - EDGE);
      tip!.style.transform = `translate(${Math.round(left)}px, ${Math.round(top)}px)`;
    }

    function showTip(cell: HTMLButtonElement): void {
      if (tipFor !== cell) {
        tipFor?.removeAttribute('aria-describedby');
        tipFor = cell;
        fillTip(cell.dataset.md!);
      }
      cell.setAttribute('aria-describedby', 'cal-tip');
      tip!.hidden = false;
      placeTip(cell);
    }

    function hideTip(): void {
      tipFor?.removeAttribute('aria-describedby');
      tipFor = null;
      tip!.hidden = true;
    }

    grid.addEventListener('pointerover', (e) => {
      const cell = cellFrom(e.target);
      if (cell) showTip(cell);
    });
    grid.addEventListener('pointerout', (e) => {
      const cell = cellFrom(e.target);
      if (!cell || cell.contains(e.relatedTarget as Node | null)) return;
      if (document.activeElement === cell && cell.matches(':focus-visible')) showTip(cell);
      else hideTip();
    });
    grid.addEventListener('focusin', (e) => {
      const cell = cellFrom(e.target);
      if (cell) showTip(cell);
    });
    grid.addEventListener('focusout', () => hideTip());
    // Keep the tooltip glued to its cell while the page or grid scrolls
    // (focusing a cell with Tab can itself scroll it into view).
    let raf = 0;
    const follow = (): void => {
      if (!tipFor || raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        if (tipFor) placeTip(tipFor);
      });
    };
    window.addEventListener('scroll', follow, { passive: true, capture: true });
    window.addEventListener('resize', follow);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hideTip();
    });

    /* ---------- search + target ---------- */

    grid.addEventListener('click', (e) => {
      const cell = cellFrom(e.target);
      if (!cell) return;
      hideTip();
      const [month, day] = cell.dataset.md!.split('-').map(Number);
      window.dispatchEvent(new CustomEvent('mdm:search', { detail: { month, day } }));
    });

    let target: HTMLElement | null = null;

    function setTarget(md: string): void {
      const next = grid!.querySelector<HTMLElement>(`button.cell[data-md="${CSS.escape(md)}"]`);
      if (!next || next === target) return;
      target?.classList.remove('is-target');
      next.classList.add('is-target');
      target = next;
    }

    window.addEventListener('mdm:result', (e) => setTarget(e.detail.md));

    // app.ts may have run its initial (hash) search before this listener
    // existed; read the same state directly so the target is never missed.
    const initial = parseHash(location.hash);
    if (initial) setTarget(toMd(initial.month, initial.day));
  }
</script>

<style>
  .cal {
    --gap: 3px;
    display: grid;
    gap: 28px;
    scroll-margin-top: 24px;
  }

  .cal__intro {
    display: grid;
    gap: 10px;
    max-width: 48ch;
  }

  .cal__title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(2.125rem, 4.8vw, 3rem);
    line-height: 1.05;
    letter-spacing: 0.01em;
  }

  /* flat, drawn-on surface */
  .cal__panel {
    display: grid;
    gap: 20px;
    justify-items: center;
    min-width: 0;
    padding: 28px 24px 22px;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  /* ---------- strips: months as rows (desktop) ---------- */

  .strips {
    --label: 2.25rem;
    --cell: 16px;
    display: grid;
    grid-template-columns: var(--label) repeat(31, minmax(0, var(--cell)));
    grid-auto-flow: row;
    gap: var(--gap);
    align-items: center;
    width: 100%;
    max-width: calc(var(--label) + 31 * (var(--cell) + var(--gap)));
    font-size: 0.625rem;
    line-height: 1;
    color: var(--ink-soft);
  }

  .strips__axis {
    text-align: center;
    font-variant-numeric: tabular-nums;
    padding-bottom: 4px;
    white-space: nowrap;
  }

  .strips__month {
    letter-spacing: 0.04em;
  }

  /* ---------- strips: months as columns (mobile) ---------- */

  @media (max-width: 639.98px) {
    .cal__panel {
      padding: 22px 12px 18px;
    }

    .strips {
      --label: 1.5rem;
      --cell: 24px;
      grid-template-columns: var(--label) repeat(12, minmax(0, var(--cell)));
      grid-template-rows: auto repeat(31, auto);
      grid-auto-flow: column;
      max-width: calc(var(--label) + 12 * (var(--cell) + var(--gap)));
    }

    .strips__axis {
      padding: 0 6px 0 0;
      text-align: right;
    }

    .strips__month {
      padding-bottom: 6px;
      text-align: center;
      letter-spacing: 0;
    }
  }

  /* ---------- cells ---------- */

  .cell {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    margin: 0;
    border: 0;
    border-radius: 2px;
    background: var(--cell-empty);
    font: inherit;
    cursor: pointer;
    transition:
      transform 140ms var(--ease),
      filter 140ms var(--ease);
  }

  .cell[data-level='1'] { background: var(--lv-1); }
  .cell[data-level='2'] { background: var(--lv-2); }
  .cell[data-level='3'] { background: var(--lv-3); }
  .cell[data-level='4'] { background: var(--lv-4); }

  .cell--void {
    visibility: hidden;
  }

  @media (hover: hover) {
    button.cell:hover {
      transform: scale(1.3);
      filter: brightness(1.15);
    }
  }

  /* keyboard focus: mustard ring */
  button.cell:focus-visible {
    position: relative;
    z-index: 2;
    outline: 2px solid var(--yellow);
    outline-offset: 2px;
  }

  /* searched day: thin white ring that breathes */
  button.cell.is-target {
    position: relative;
    z-index: 1;
    outline: 1.5px solid var(--target);
    outline-offset: 1px;
    animation: cell-pulse 2.6s var(--ease) infinite;
  }

  /* focused target: white ring tight, mustard ring outside, both readable */
  button.cell.is-target:focus-visible {
    z-index: 2;
    outline: 2px solid var(--yellow);
    outline-offset: 4px;
    animation: none;
    box-shadow:
      0 0 0 1px var(--bg-raised),
      0 0 0 2.5px var(--target);
  }

  @media (prefers-reduced-motion: reduce) {
    button.cell.is-target {
      animation: none;
    }
    button.cell:hover {
      transform: none;
    }
  }

  /* ---------- legend ---------- */

  .cal__legend {
    display: flex;
    align-items: center;
    gap: var(--gap);
    justify-self: end;
    font-size: 0.625rem;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  .cal__legend .cell {
    width: 12px;
    cursor: default;
  }

  .cal__legend span:first-child {
    margin-right: 6px;
  }
  .cal__legend span:last-child {
    margin-left: 6px;
  }

  @media (min-width: 640px) {
    .cal__legend {
      justify-self: center;
      width: 100%;
      max-width: calc(2.25rem + 31 * 19px);
      justify-content: flex-end;
    }
  }

  @media (max-width: 639.98px) {
    .cal__legend {
      justify-self: center;
    }
  }

  /* ---------- tooltip: a tiny piece of the cover ---------- */

  .cal-tip {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    max-width: min(280px, calc(100vw - 16px));
    padding: 10px 12px 11px;
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--ink);
    background: var(--blue);
    border: 1px solid var(--blue-bright);
    border-radius: 6px;
    pointer-events: none;
  }

  .cal-tip[hidden] {
    display: none;
  }

  .cal-tip__head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--yellow);
  }

  .cal-tip__count {
    font-weight: 400;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .cal-tip__list {
    margin: 6px 0 0;
    padding: 6px 0 0;
    list-style: none;
    border-top: 1px solid rgba(236, 230, 200, 0.16);
    overflow-wrap: anywhere;
  }

  .cal-tip__list :global(li)::before {
    content: '♪ ';
    color: var(--yellow);
  }

  .cal-tip__hint {
    margin-top: 4px;
    color: var(--ink-soft);
  }
</style>
