---
/*
 * GitHub contribution graph over the reference leap year 2024: columns are
 * weeks (Monday first), rows are weekdays, green by number of songs.
 * All cells render at build time; the <script> below only adds the shared
 * tooltip, click → `mdm:search`, and the `.is-target` highlight on `mdm:result`.
 */
import db from '../data/songs.json';
import { cellLabel, levelFor, monthAbbr, monthLabelColumns, weekGrid } from '../lib/calendar';
import { countCoveredDays } from '../lib/format';
import type { DB } from '../lib/types';

const data = db as DB;
const covered = countCoveredDays(data);

const weeks = weekGrid(2024).map((col) =>
  col.map((cell) => {
    if (!cell) return null;
    const count = data.days[cell.md]?.length ?? 0;
    return { md: cell.md, level: levelFor(count), label: cellLabel(cell.md, count) };
  }),
);
const months = monthLabelColumns(2024).map(({ month, col }) => ({ col, abbr: monthAbbr(month) }));
const WEEKDAYS = ['lun', '', 'mié', '', 'vie', '', ''];
---

<section id="calendar" class="cal" aria-labelledby="cal-title">
  <div class="cal__head">
    <div class="cal__intro">
      <h2 id="cal-title" class="cal__title">Todo el año</h2>
      <p class="lede cal__lede">
        Cada cuadradito es un día. Verde si hay canción, más verde si hay varias. Tocá uno para verlo.
      </p>
    </div>
    <p class="cal__stat">
      <span class="cal__stat-num">{covered}</span>
      <span class="cal__stat-text">de 366 días tienen canción</span>
    </p>
  </div>

  <div class="cal__panel">
    <span class="cal__screw cal__screw--tl" aria-hidden="true"></span>
    <span class="cal__screw cal__screw--tr" aria-hidden="true"></span>
    <span class="cal__screw cal__screw--bl" aria-hidden="true"></span>
    <span class="cal__screw cal__screw--br" aria-hidden="true"></span>

    <div class="cal__scroll" id="cal-scroll">
      <div class="gh" style={`--weeks: ${weeks.length}`}>
        <div class="gh__months" aria-hidden="true">
          {months.map((m) => <span style={`grid-column: ${m.col + 1} / span 4`}>{m.abbr}</span>)}
        </div>
        <div class="gh__weekdays" aria-hidden="true">
          {WEEKDAYS.map((d) => <span>{d}</span>)}
        </div>
        <div class="gh__grid" id="cal-grid">
          {
            weeks.flat().map((c) =>
              c ? (
                <button type="button" class="cell" data-md={c.md} data-level={c.level} aria-label={c.label} />
              ) : (
                <span class="cell cell--void" aria-hidden="true" />
              ),
            )
          }
        </div>
        <div class="gh__foot">
          <span class="side-mark" aria-hidden="true">B</span>
          <div class="gh__legend" aria-hidden="true">
            <span>menos</span>
            {[0, 1, 2, 3, 4].map((level) => <span class="cell cell--swatch" data-level={level} />)}
            <span>más</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="cal-tip" id="cal-tip" role="tooltip" hidden>
    <p class="cal-tip__head"><span class="cal-tip__date"></span><span class="cal-tip__count"></span></p>
    <ul class="cal-tip__list"></ul>
    <p class="cal-tip__hint"></p>
  </div>
</section>

<script>
  import { countLabel } from '../lib/calendar';
  import { spokenDate } from '../lib/format';
  import { parseHash, toMd } from '../lib/nearest';
  import type { DB } from '../lib/types';

  const MAX_TITLES = 4;
  const EDGE = 8; // min distance from the viewport edge
  const GAP = 10; // distance between cell and tooltip

  const grid = document.getElementById('cal-grid');
  const tip = document.getElementById('cal-tip');
  const dbNode = document.getElementById('db');

  if (grid && tip && dbNode) {
    const db = JSON.parse(dbNode.textContent ?? '{}') as DB;
    const scroller = document.getElementById('cal-scroll') ?? grid;
    const tipDate = tip.querySelector<HTMLElement>('.cal-tip__date')!;
    const tipCount = tip.querySelector<HTMLElement>('.cal-tip__count')!;
    const tipList = tip.querySelector<HTMLUListElement>('.cal-tip__list')!;
    const tipHint = tip.querySelector<HTMLElement>('.cal-tip__hint')!;

    const cellFrom = (node: EventTarget | null): HTMLButtonElement | null =>
      node instanceof Element ? node.closest<HTMLButtonElement>('button.cell[data-md]') : null;

    /* ---------- tooltip ---------- */

    let tipFor: HTMLButtonElement | null = null;

    function fillTip(md: string): void {
      const titles = (db.days?.[md] ?? []).map((i) => db.songs[i]?.title).filter(Boolean) as string[];
      tipDate.textContent = spokenDate(md);
      tipCount.textContent = countLabel(titles.length);
      tipList.replaceChildren(
        ...titles.slice(0, MAX_TITLES).map((title) => {
          const li = document.createElement('li');
          li.textContent = title;
          return li;
        }),
      );
      tipList.hidden = titles.length === 0;
      const extra = titles.length - MAX_TITLES;
      tipHint.textContent =
        titles.length === 0 ? 'tocá para ver la más cercana' : extra > 0 ? `y ${extra} más · tocá para verlas` : '';
      tipHint.hidden = tipHint.textContent === '';
    }

    function placeTip(cell: HTMLElement): void {
      const r = cell.getBoundingClientRect();
      const vw = document.documentElement.clientWidth;
      const vh = window.innerHeight;
      const { width, height } = tip!.getBoundingClientRect();
      let left = r.left + r.width / 2 - width / 2;
      left = Math.max(EDGE, Math.min(left, vw - width - EDGE));
      let top = r.top - height - GAP;
      if (top < EDGE) top = Math.min(r.bottom + GAP, vh - height - EDGE);
      tip!.style.transform = `translate(${Math.round(left)}px, ${Math.round(top)}px)`;
    }

    function showTip(cell: HTMLButtonElement): void {
      if (tipFor !== cell) {
        tipFor?.removeAttribute('aria-describedby');
        tipFor = cell;
        fillTip(cell.dataset.md!);
      }
      cell.setAttribute('aria-describedby', 'cal-tip');
      tip!.hidden = false;
      placeTip(cell);
    }

    function hideTip(): void {
      tipFor?.removeAttribute('aria-describedby');
      tipFor = null;
      tip!.hidden = true;
    }

    grid.addEventListener('pointerover', (e) => {
      const cell = cellFrom(e.target);
      if (cell) showTip(cell);
    });
    grid.addEventListener('pointerout', (e) => {
      const cell = cellFrom(e.target);
      if (!cell || cell.contains(e.relatedTarget as Node | null)) return;
      if (document.activeElement === cell && cell.matches(':focus-visible')) showTip(cell);
      else hideTip();
    });
    grid.addEventListener('focusin', (e) => {
      const cell = cellFrom(e.target);
      if (cell) showTip(cell);
    });
    grid.addEventListener('focusout', () => hideTip());
    // Keep the tooltip glued to its cell while the page or grid scrolls
    // (focusing a cell with Tab can itself scroll it into view).
    let raf = 0;
    const follow = (): void => {
      if (!tipFor || raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        if (tipFor) placeTip(tipFor);
      });
    };
    window.addEventListener('scroll', follow, { passive: true, capture: true });
    window.addEventListener('resize', follow);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hideTip();
    });

    /* ---------- search + target ---------- */

    grid.addEventListener('click', (e) => {
      const cell = cellFrom(e.target);
      if (!cell) return;
      hideTip();
      const [month, day] = cell.dataset.md!.split('-').map(Number);
      window.dispatchEvent(new CustomEvent('mdm:search', { detail: { month, day } }));
    });

    let target: HTMLElement | null = null;

    function setTarget(md: string): void {
      const next = grid!.querySelector<HTMLElement>(`button.cell[data-md="${CSS.escape(md)}"]`);
      if (!next || next === target) return;
      target?.classList.remove('is-target');
      next.classList.add('is-target');
      target = next;
      // On mobile the grid scrolls sideways: bring the target into view there
      // without touching the page's vertical scroll.
      if (scroller.scrollWidth > scroller.clientWidth) {
        const s = scroller.getBoundingClientRect();
        const c = next.getBoundingClientRect();
        const pad = 48;
        if (c.left < s.left + pad || c.right > s.right - pad) {
          scroller.scrollLeft += c.left - s.left - s.width / 2 + c.width / 2;
        }
      }
    }

    window.addEventListener('mdm:result', (e) => setTarget(e.detail.md));

    // app.ts may have run its initial (hash) search before this listener
    // existed; read the same state directly so the target is never missed.
    const initial = parseHash(location.hash);
    if (initial) setTarget(toMd(initial.month, initial.day));
  }
</script>

<style>
  .cal {
    --cell: 11px;
    --gap: 3px;
    --day-col: 30px;
    display: grid;
    gap: 24px;
    scroll-margin-top: 24px;
  }

  /* ---------- header ---------- */

  .cal__head {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 720px) {
    .cal__head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 40px;
    }
  }

  .cal__intro {
    display: grid;
    gap: 10px;
    max-width: 48ch;
  }

  .cal__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.6vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .cal__stat {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .cal__stat-num {
    font-family: var(--serif);
    font-size: 3.25rem;
    line-height: 1;
    color: var(--green-4);
    font-variant-numeric: tabular-nums;
  }

  .cal__stat-text {
    max-width: 14ch;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  /* ---------- panel: a cassette shell with four tiny screws ---------- */

  .cal__panel {
    position: relative;
    min-width: 0;
    background:
      repeating-linear-gradient(to bottom, transparent 0 2px, rgba(239, 230, 212, 0.012) 2px 3px),
      var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: inset 0 1px 0 var(--line-soft);
  }

  .cal__screw {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--bg) 0 0.6px, #3a3128 1px);
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.6);
    pointer-events: none;
  }
  .cal__screw--tl { top: 8px; left: 8px; }
  .cal__screw--tr { top: 8px; right: 8px; }
  .cal__screw--bl { bottom: 8px; left: 8px; }
  .cal__screw--br { bottom: 8px; right: 8px; }

  .cal__scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
    /* room for the target outline + pulse so it is never clipped */
    padding: 24px 28px 20px;
  }

  /* ---------- graph ---------- */

  .gh {
    display: grid;
    grid-template-columns: var(--day-col) max-content;
    grid-template-areas:
      '. months'
      'days grid'
      '. foot';
    row-gap: 6px;
    width: max-content;
    margin-inline: auto;
    font-size: 0.625rem;
    line-height: 1;
    color: var(--ink-soft);
  }

  .gh__months {
    grid-area: months;
    display: grid;
    grid-template-columns: repeat(var(--weeks), var(--cell));
    column-gap: var(--gap);
    height: 12px;
  }

  .gh__months span {
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  .gh__weekdays {
    grid-area: days;
    display: grid;
    grid-template-rows: repeat(7, var(--cell));
    row-gap: var(--gap);
    align-items: center;
  }

  .gh__grid {
    grid-area: grid;
    display: grid;
    grid-template-rows: repeat(7, var(--cell));
    grid-auto-flow: column;
    grid-auto-columns: var(--cell);
    gap: var(--gap);
  }

  .gh__foot {
    grid-area: foot;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 8px;
  }

  .gh__legend {
    display: flex;
    align-items: center;
    gap: var(--gap);
    letter-spacing: 0.02em;
  }

  .gh__legend span:first-child {
    margin-right: 4px;
  }
  .gh__legend span:last-child {
    margin-left: 4px;
  }

  /* ---------- cells ---------- */

  .cell {
    display: block;
    width: var(--cell);
    height: var(--cell);
    padding: 0;
    margin: 0;
    border: 0;
    border-radius: 2px;
    background: var(--cell-empty);
    box-shadow: inset 0 0 0 1px var(--line);
    font: inherit;
    cursor: pointer;
    transition:
      transform 140ms var(--ease),
      filter 140ms var(--ease);
  }

  .cell[data-level='1'] { background: var(--green-1); box-shadow: none; }
  .cell[data-level='2'] { background: var(--green-2); box-shadow: none; }
  .cell[data-level='3'] { background: var(--green-3); box-shadow: none; }
  .cell[data-level='4'] { background: var(--green-4); box-shadow: none; }

  .cell--void {
    visibility: hidden;
  }

  .cell--swatch {
    cursor: default;
  }

  @media (hover: hover) {
    button.cell:hover {
      transform: scale(1.25);
      filter: brightness(1.15);
    }
  }

  /* keyboard focus: cream ring */
  button.cell:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  /* searched day: accent ring that breathes */
  button.cell.is-target {
    position: relative;
    z-index: 1;
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    animation: cell-pulse 2.4s var(--ease) infinite;
  }

  /* focused target: cream ring inside, accent ring outside — both readable */
  button.cell.is-target:focus-visible {
    outline-color: var(--ink);
    animation: none;
    box-shadow:
      0 0 0 4px var(--bg-raised),
      0 0 0 6px var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    button.cell.is-target {
      animation: none;
    }
    button.cell:hover {
      transform: none;
    }
  }

  @media (max-width: 639.98px) {
    .cal {
      --cell: 10px;
      --day-col: 26px;
    }

    .cal__scroll {
      padding: 20px 18px 16px;
    }

    .gh {
      margin-inline: 0;
    }
  }

  /* ---------- tooltip ---------- */

  .cal-tip {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    max-width: min(280px, calc(100vw - 16px));
    padding: 10px 12px 11px;
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--bg);
    background: var(--ink);
    border-radius: 6px;
    box-shadow: 0 10px 28px -10px rgba(0, 0, 0, 0.9);
    pointer-events: none;
  }

  .cal-tip[hidden] {
    display: none;
  }

  .cal-tip__head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .cal-tip__count {
    font-weight: 400;
    color: var(--green-2);
    white-space: nowrap;
  }

  .cal-tip__list {
    margin: 6px 0 0;
    padding: 6px 0 0;
    list-style: none;
    border-top: 1px solid rgba(15, 13, 11, 0.14);
    overflow-wrap: anywhere;
  }

  .cal-tip__list :global(li)::before {
    content: '♪ ';
    color: var(--accent);
  }

  .cal-tip__hint {
    margin-top: 4px;
    color: rgba(15, 13, 11, 0.62);
  }
</style>
