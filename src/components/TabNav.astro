---
interface Props {
  current: 'buscar' | 'estadisticas';
}

const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const tabs = [
  { id: 'buscar', label: 'Buscar', href: base },
  { id: 'estadisticas', label: 'Estadísticas', href: `${base}estadisticas/` },
] as const;
---

<nav class="container tabs" aria-label="Secciones">
  <ul class="tabs__list">
    {
      tabs.map((tab) => (
        <li>
          <a class="tabs__link" href={tab.href} aria-current={tab.id === current ? 'page' : undefined}>
            {tab.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tabs {
    padding-top: 20px;
  }

  .tabs__list {
    display: flex;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tabs__link {
    display: inline-block;
    padding: 6px 0;
    font-family: var(--round);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    text-decoration: none;
    text-underline-offset: 6px;
    text-decoration-thickness: 1.5px;
    transition: color 160ms var(--ease);
  }

  .tabs__link:hover {
    color: var(--ink);
  }

  .tabs__link[aria-current='page'] {
    color: var(--yellow);
    text-decoration-line: underline;
  }
</style>
