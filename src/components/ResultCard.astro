---
/*
 * Result region + the cassette-label card template.
 * app.ts clones #card-template and fills it with textContent / attributes,
 * so these styles are global (cloned nodes carry no scope attribute).
 */
---

<div id="result" class="result" aria-live="polite"></div>

<template id="card-template">
  <article class="card">
    <header class="card__top">
      <span class="side-mark" aria-hidden="true">A</span>
      <span class="card__date"></span>
      <span class="card__reels" aria-hidden="true"></span>
    </header>
    <div class="card__stripe" aria-hidden="true"></div>
    <div class="card__label">
      <h2 class="card__title"></h2>
    </div>
    <footer class="card__foot">
      <span class="card__album"></span>
      <a class="card__link" target="_blank" rel="noopener">Escuchar en Spotify<span class="card__link-arrow" aria-hidden="true">↗</span><span class="card__link-title visually-hidden"></span></a>
    </footer>
  </article>
</template>

<style is:global>
  .result {
    display: grid;
    gap: 28px;
    scroll-margin-top: 24px;
  }

  .result:empty {
    display: none;
  }

  .result__sentence {
    font-family: var(--serif);
    font-size: clamp(1.625rem, 3.6vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.005em;
    max-width: 30ch;
    text-wrap: pretty;
    animation: rise 420ms var(--ease) both;
  }

  .result__group {
    display: grid;
    gap: 12px;
  }

  .result__label {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .result__label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .result__cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 16px;
  }

  /* ---------- cassette label ---------- */

  .card {
    --rule: 2.25rem;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow:
      inset 0 1px 0 var(--line-soft),
      0 12px 32px -18px rgba(0, 0, 0, 0.8);
    animation: rise 460ms var(--ease) both;
    animation-delay: calc(var(--i, 0) * 70ms + 80ms);
  }

  .card__top {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px 10px;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }

  .card__date {
    font-variant-numeric: tabular-nums;
  }

  /* tiny tape window with two reels */
  .card__reels {
    margin-left: auto;
    width: 44px;
    height: 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background:
      radial-gradient(circle at 11px 50%, var(--ink-soft) 0 1.5px, transparent 2px 4px, var(--line) 4.5px 5.5px, transparent 6px),
      radial-gradient(circle at calc(100% - 11px) 50%, var(--ink-soft) 0 1.5px, transparent 2px 4px, var(--line) 4.5px 5.5px, transparent 6px);
  }

  /* thin two-tone band */
  .card__stripe {
    height: 6px;
    margin-inline: 16px;
    background: linear-gradient(
      to bottom,
      var(--accent) 0 2px,
      transparent 2px 4px,
      var(--line) 4px 5px,
      transparent 5px
    );
  }

  /* ruled writing area */
  .card__label {
    flex: 1;
    padding: 6px 16px calc(var(--rule) * 0.5);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(var(--rule) - 1px),
      var(--line-soft) calc(var(--rule) - 1px),
      var(--line-soft) var(--rule)
    );
    background-origin: content-box;
    background-clip: content-box;
    min-height: calc(var(--rule) * 2 + 6px + var(--rule) * 0.5);
  }

  .card__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.75rem;
    line-height: var(--rule);
    letter-spacing: -0.005em;
    overflow-wrap: anywhere;
  }

  .card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 12px;
    padding: 12px 16px 14px;
    border-top: 1px solid var(--line);
  }

  .card__album {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
    min-width: 0;
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    color: var(--ink);
    border: 1px solid rgba(239, 230, 212, 0.28);
    border-radius: 999px;
    transition:
      background-color 160ms var(--ease),
      border-color 160ms var(--ease),
      color 160ms var(--ease);
  }

  .card__link:focus-visible {
    outline-offset: 2px;
  }

  .card__link-arrow {
    color: var(--accent);
    transition:
      transform 160ms var(--ease),
      color 160ms var(--ease);
  }

  @media (hover: hover) {
    .card__link:hover {
      color: var(--bg);
      background: var(--ink);
      border-color: var(--ink);
    }
    .card__link:hover .card__link-arrow {
      color: inherit;
      transform: translate(2px, -2px);
    }
  }
</style>
