---
/*
 * Result region + the cassette-label card template.
 * app.ts clones #card-template and fills it with textContent / attributes,
 * so these styles are global (cloned nodes carry no scope attribute).
 */
---

<div id="result" class="result" aria-live="polite"></div>

<template id="card-template">
  <article class="card">
    <header class="card__top">
      <span class="card__side" aria-hidden="true">A</span>
      <span class="card__date"></span>
      <span class="card__reels" aria-hidden="true"></span>
    </header>
    <div class="card__stripe" aria-hidden="true"></div>
    <div class="card__label">
      <h2 class="card__title"></h2>
    </div>
    <footer class="card__foot">
      <span class="card__album"></span>
      <a class="card__link" target="_blank" rel="noopener">Escuchar en Spotify <span aria-hidden="true">↗</span></a>
    </footer>
  </article>
</template>

<style is:global>
  .result {
    display: grid;
    gap: 28px;
    scroll-margin-top: 24px;
  }

  .result:empty {
    display: none;
  }

  .result__sentence {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 3.4vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.005em;
    max-width: 32ch;
    text-wrap: pretty;
    animation: rise 420ms var(--ease) both;
  }

  .result__group {
    display: grid;
    gap: 12px;
  }

  .result__label {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .result__label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--hairline);
  }

  .result__cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 16px;
  }

  /* ---------- cassette label ---------- */

  .card {
    --line: 2.25rem;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 1px 0 var(--hairline);
    animation: rise 460ms var(--ease) both;
    animation-delay: calc(var(--i, 0) * 70ms + 80ms);
  }

  .card__top {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px 10px;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .card__side {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    font-weight: 600;
    font-size: 0.6875rem;
    color: var(--paper);
    background: var(--ink);
    border-radius: 50%;
    letter-spacing: 0;
  }

  .card__date {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* tiny tape window with two reels */
  .card__reels {
    margin-left: auto;
    width: 46px;
    height: 18px;
    border: 1.5px solid var(--ink);
    border-radius: 9px;
    background:
      radial-gradient(circle at 12px 50%, var(--ink) 0 2px, transparent 2.5px 4.5px, var(--ink) 5px 5.75px, transparent 6.25px),
      radial-gradient(circle at calc(100% - 12px) 50%, var(--ink) 0 2px, transparent 2.5px 4.5px, var(--ink) 5px 5.75px, transparent 6.25px);
  }

  /* retro two-tone band */
  .card__stripe {
    height: 7px;
    background: linear-gradient(
      to bottom,
      var(--accent) 0 3px,
      transparent 3px 5px,
      var(--ink) 5px 6px,
      transparent 6px
    );
  }

  /* ruled writing area */
  .card__label {
    flex: 1;
    padding: 6px 16px calc(var(--line) * 0.5);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(var(--line) - 1px),
      var(--rule) calc(var(--line) - 1px),
      var(--rule) var(--line)
    );
    background-origin: content-box;
    background-clip: content-box;
    min-height: calc(var(--line) * 2 + 6px + var(--line) * 0.5);
  }

  .card__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.75rem;
    line-height: var(--line);
    letter-spacing: -0.005em;
    overflow-wrap: anywhere;
  }

  .card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 12px;
    padding: 12px 16px 14px;
    border-top: 1px dashed var(--hairline);
  }

  .card__album {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--ink-soft);
    min-width: 0;
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    color: var(--ink);
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    transition:
      background-color 160ms var(--ease),
      color 160ms var(--ease);
  }

  .card__link:hover {
    color: var(--paper);
    background: var(--ink);
  }

  .card__link span {
    transition: transform 160ms var(--ease);
  }

  .card__link:hover span {
    transform: translate(2px, -2px);
  }
</style>
