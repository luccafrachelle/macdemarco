---
/*
 * Result region + the cassette-label card template.
 * app.ts clones #card-template and fills it with textContent / attributes,
 * so these styles are global (cloned nodes carry no scope attribute).
 */
---

<div id="result" class="result" aria-live="polite"></div>

<template id="card-template">
  <article class="card">
    <p class="card__date"></p>
    <h2 class="card__title"></h2>
    <p class="card__album"></p>
    <div class="card__player"></div>
    <a class="card__link" target="_blank" rel="noopener"
      >Abrir en Spotify <span aria-hidden="true">↗</span><span class="card__link-title visually-hidden"></span></a
    >
  </article>
</template>

<style is:global>
  .result {
    display: grid;
    gap: 28px;
    scroll-margin-top: 24px;
  }

  .result:empty {
    display: none;
  }

  .result__sentence {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.75rem, 3.8vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: 0.01em;
    max-width: 28ch;
    text-wrap: pretty;
    animation: rise 420ms var(--ease) both;
  }

  .result__group {
    display: grid;
    gap: 14px;
  }

  .result__label {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .result__label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .result__cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 16px;
  }

  /* ---------- card: a small square of the cover ---------- */

  .card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 20px 18px 16px;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 14px;
    animation: rise 460ms var(--ease) both;
    animation-delay: calc(var(--i, 0) * 70ms + 80ms);
  }

  .card__date {
    font-family: var(--round);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--yellow);
  }

  .card__title {
    margin-top: 10px;
    font-family: var(--round);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: 0;
    color: var(--ink);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .card__album {
    margin-top: 4px;
    font-family: var(--round);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .card__player {
    margin-top: auto;
    padding-top: 18px;
  }

  .card__player:empty {
    display: none;
  }

  /* Spotify's player has its own 12px corners. With a dark page the iframe would paint an opaque
     light canvas behind them (white corners), so give it the light scheme to keep it transparent. */
  .card__frame {
    display: block;
    height: 80px;
    overflow: hidden;
    border-radius: 12px;
    background: var(--blue); /* shows while the player loads */
    isolation: isolate;
  }

  .card__frame iframe {
    display: block;
    width: 100%;
    height: 80px;
    border: 0;
    border-radius: 12px;
    color-scheme: light;
    background: transparent;
  }

  /* light stand-in for the Spotify player on phones (same 80px, so nothing jumps when it swaps) */
  .card__play {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    height: 80px;
    padding: 0 16px;
    font: inherit;
    font-family: var(--round);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--ink);
    text-align: left;
    background: var(--blue);
    border: 1px solid var(--line);
    border-radius: 12px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .card__play-icon {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--yellow);
  }

  .card__play-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 54%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 8px 0 8px 13px;
    border-color: transparent transparent transparent var(--bg);
  }

  .card__play:active .card__play-icon {
    transform: scale(0.94);
  }

  .card__link {
    align-self: flex-start;
    margin-top: 12px;
    font-family: var(--round);
    font-weight: 600;
    font-size: 0.75rem;
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-color: rgba(236, 230, 200, 0.28);
    text-underline-offset: 3px;
    transition:
      color 160ms var(--ease),
      text-decoration-color 160ms var(--ease);
  }

  /* no player (unusual link): the text link becomes the main action */
  .card__player:empty + .card__link {
    margin-top: auto;
    padding-top: 18px;
    font-size: 0.8125rem;
    color: var(--ink);
  }

  .card__link:focus-visible {
    outline-offset: 3px;
    border-radius: 2px;
  }

  @media (hover: hover) {
    .card__link:hover {
      color: var(--yellow);
      text-decoration-color: currentColor;
    }
  }
</style>
