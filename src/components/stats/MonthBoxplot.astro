---
/*
 * Chart 1: per month, the spread across recording years of "songs that month
 * that year". Box Q1–Q3 (linear-interpolation quartiles), median line,
 * whiskers to min/max. The month total is a text label, not a second axis.
 */
import { niceTicks } from '../../lib/chart';
import { monthName } from '../../lib/format';
import { fmtNum, recordingYears, type MonthBox } from '../../lib/stats';
import type { Song } from '../../lib/types';

interface Props {
  boxes: MonthBox[];
  songs: Song[];
}

const { boxes, songs } = Astro.props;

const W = 400;
const H = 236;
const M = { top: 40, right: 4, bottom: 24, left: 26 };
const plotW = W - M.left - M.right;
const plotH = H - M.top - M.bottom;
const base = M.top + plotH;
const band = plotW / 12;
const boxW = 18; // ~58% of the band

const scale = niceTicks(Math.max(...boxes.map((b) => b.box.max)));
const y = (v: number): number => base - (v / scale.max) * plotH;
const peak = Math.max(...boxes.map((b) => b.total));
const years = recordingYears(songs);

const marks = boxes.map((b, i) => {
  const cx = M.left + band * i + band / 2;
  const top = y(b.box.q3);
  const boxH = Math.max(y(b.box.q1) - top, 2);
  return {
    ...b,
    cx,
    x0: M.left + band * i,
    boxY: Math.min(top, base - 2),
    boxH,
    isMax: b.total === peak,
    tipHead: `${monthName(b.month)} · ${b.total} en total`,
    tip: `por año: mediana ${fmtNum(b.box.median)}, la mitad entre ${fmtNum(b.box.q1)} y ${fmtNum(b.box.q3)}, de ${b.box.min} a ${b.box.max}`,
  };
});
---

<svg class="ch-svg" viewBox={`0 0 ${W} ${H}`} role="group" aria-label="Canciones por mes, una caja por mes">
  {
    scale.ticks.map((t) => (
      <g>
        {t > 0 && <line class="ch-grid" x1={M.left} x2={W - M.right} y1={y(t)} y2={y(t)} />}
        <text class="ch-axis" x={M.left - 6} y={y(t)} dy="0.35em" text-anchor="end">
          {t}
        </text>
      </g>
    ))
  }
  <line class="ch-base" x1={M.left} x2={W - M.right} y1={base} y2={base} />
  <text class="ch-axis" x={M.left - 6} y={M.top - 18} text-anchor="end">total</text>

  {
    marks.map((m) => (
      <g
        class="mark"
        tabindex="0"
        role="img"
        aria-label={`${m.tipHead}. ${m.tip}`}
        data-tip-head={m.tipHead}
        data-tip={m.tip}
      >
        <rect class="mark__hit" x={m.x0} y={M.top - 30} width={band} height={plotH + 30} />
        <g class:list={['mark__shape', { 'is-dim': !m.isMax }]}>
          <line class="whisker" x1={m.cx} x2={m.cx} y1={y(m.box.min)} y2={y(m.box.max)} />
          <line class="whisker" x1={m.cx - 5} x2={m.cx + 5} y1={y(m.box.max)} y2={y(m.box.max)} />
          <rect class="ch-fill" x={m.cx - boxW / 2} y={m.boxY} width={boxW} height={m.boxH} rx="2" />
          <line class="median" x1={m.cx - boxW / 2} x2={m.cx + boxW / 2} y1={y(m.box.median)} y2={y(m.box.median)} />
        </g>
        <text
          class:list={['ch-val', { 'ch-val--max': m.isMax }]}
          x={m.cx}
          y={M.top - 18}
          text-anchor="middle"
        >
          {m.total}
        </text>
        <text class="ch-axis" x={m.cx} y={H - 6} text-anchor="middle">
          {monthName(m.month).slice(0, 3)}
        </text>
      </g>
    ))
  }
</svg>

<p class="ch-note">
  Cada caja junta los {years.length} años con canciones: la mitad de los años cae adentro, la raya es la mediana y la línea
  va del año más flojo al más cargado. Arriba, el total del mes.
</p>

<details class="ch-data">
  <summary>Ver datos</summary>
  <div class="ch-table-wrap">
<table class="ch-table">
  <caption>
    Canciones por mes en cada año con grabaciones ({years.join(', ')}). Cuartiles con interpolación lineal; los
    bigotes van al mínimo y al máximo, sin regla de atípicos.
  </caption>
  <thead>
    <tr><th scope="col">Mes</th><th scope="col">Total</th><th scope="col">Mín</th><th scope="col">Q1</th><th
        scope="col">Mediana</th><th scope="col">Q3</th><th scope="col">Máx</th></tr>
  </thead>
  <tbody>
    {
      boxes.map((b) => (
        <tr>
          <th scope="row">{monthName(b.month)}</th>
          <td>{b.total}</td>
          <td>{b.box.min}</td>
          <td>{fmtNum(b.box.q1)}</td>
          <td>{fmtNum(b.box.median)}</td>
          <td>{fmtNum(b.box.q3)}</td>
          <td>{b.box.max}</td>
        </tr>
      ))
    }
  </tbody>
</table>
  </div>
</details>

<style>
  /* the shared .mark__shape hover rule zeroes stroke-opacity; these lines are data, keep them visible */
  .whisker {
    stroke-opacity: 1;
    stroke: var(--c-single);
    stroke-width: 1.5px;
    vector-effect: non-scaling-stroke;
  }

  .median {
    stroke-opacity: 1;
    stroke: var(--bg);
    stroke-width: 2px;
    vector-effect: non-scaling-stroke;
  }

  /* the hover outline goes on the box, not the whiskers */
  .mark__shape {
    stroke: none;
  }

  .mark:hover .ch-fill,
  .mark.is-active .ch-fill,
  .mark:focus-visible .ch-fill {
    stroke: var(--ink);
    stroke-width: 1.5px;
    vector-effect: non-scaling-stroke;
  }
</style>
