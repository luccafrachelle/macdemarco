---
/*
 * Chart 3: songs per year, every year in range (empty ones stay as "nada").
 * One Wayne G vs the newer albums; a year with both is stacked with a 2px gap.
 */
import { barPath, niceTicks, stack } from '../../lib/chart';
import type { YearBar } from '../../lib/stats';

interface Props {
  bars: YearBar[];
  newAlbums: string[];
}

const { bars, newAlbums } = Astro.props;
const albumList =
  newAlbums.length > 1 ? `${newAlbums.slice(0, -1).join(', ')} y ${newAlbums[newAlbums.length - 1]}` : newAlbums.join('');

const GROUPS = ['One Wayne G', 'discos nuevos'] as const;

const W = 400;
const H = 248;
const M = { top: 26, right: 4, bottom: 52, left: 26 };
const plotW = W - M.left - M.right;
const plotH = H - M.top - M.bottom;
const base = M.top + plotH;
const band = plotW / bars.length;
const barW = Math.round(band * 0.64);

const scale = niceTicks(Math.max(...bars.map((b) => b.total)));
const k = plotH / scale.max;
const y = (v: number): number => base - v * k;
const peak = Math.max(...bars.map((b) => b.total));

const marks = bars.map((b, i) => {
  const x0 = M.left + band * i;
  const x = x0 + (band - barW) / 2;
  const segs = stack([b.owg, b.nuevos], base, k, 2).map((s) => ({
    ...s,
    d: barPath(x, s.y, barW, s.h, s.top ? 4 : 0),
    cls: s.index === 0 ? 'ch-fill--a' : 'ch-fill--b',
  }));
  const topY = segs.length ? segs[segs.length - 1].y : base;
  const parts = [b.owg && `${GROUPS[0]}: ${b.owg}`, b.nuevos && `${GROUPS[1]}: ${b.nuevos}`].filter(Boolean);
  return {
    ...b,
    x0,
    cx: x0 + band / 2,
    segs,
    topY,
    isMax: b.total === peak,
    tipHead: `${b.year} · ${b.total === 0 ? 'ninguna' : `${b.total} ${b.total === 1 ? 'canción' : 'canciones'}`}`,
    tip: parts.join(' · '),
  };
});

// Direct labels: a bracket under each run of consecutive years that has the group.
type Run = { group: 0 | 1; from: number; to: number };
const runs: Run[] = [];
for (const group of [0, 1] as const) {
  let open: Run | null = null;
  marks.forEach((m, i) => {
    const has = group === 0 ? m.owg > 0 : m.nuevos > 0;
    if (has && open) open.to = i;
    else if (has) runs.push((open = { group, from: i, to: i }));
    else open = null;
  });
}
const brackets = runs.map((r) => ({
  ...r,
  x1: M.left + band * r.from + 4,
  x2: M.left + band * (r.to + 1) - 4,
  label: GROUPS[r.group],
}));
---

<ul class="ch-legend">
  <li><span class="ch-swatch ch-swatch--a"></span>{GROUPS[0]}</li>
  <li><span class="ch-swatch ch-swatch--b"></span>{GROUPS[1]}</li>
</ul>

<svg class="ch-svg" viewBox={`0 0 ${W} ${H}`} role="group" aria-label="Canciones por año">
  {
    scale.ticks.map((t) => (
      <g>
        {t > 0 && <line class="ch-grid" x1={M.left} x2={W - M.right} y1={y(t)} y2={y(t)} />}
        <text class="ch-axis" x={M.left - 6} y={y(t)} dy="0.35em" text-anchor="end">
          {t}
        </text>
      </g>
    ))
  }
  {
    marks.map((m) => (
      <g
        class="mark"
        tabindex="0"
        role="img"
        aria-label={`${m.tipHead}${m.tip ? `. ${m.tip}` : ''}`}
        data-tip-head={m.tipHead}
        data-tip={m.tip}
      >
        <rect class="mark__hit" x={m.x0} y={M.top - 20} width={band} height={plotH + 40} />
        {m.segs.map((s) => (
          <path class:list={['mark__shape', s.cls]} d={s.d} />
        ))}
        {m.total === 0 ? (
          <text class="ch-val ch-val--none" x={m.cx} y={base - 7} text-anchor="middle">
            nada
          </text>
        ) : (
          <text class:list={['ch-val', { 'ch-val--max': m.isMax }]} x={m.cx} y={m.topY - 7} text-anchor="middle">
            {m.total}
          </text>
        )}
        <text class="ch-axis" x={m.cx} y={base + 17} text-anchor="middle">
          {m.year}
        </text>
      </g>
    ))
  }
  <line class="ch-base" x1={M.left} x2={W - M.right} y1={base} y2={base} />
  {
    brackets.map((b) => (
      <g class="bracket" aria-hidden="true">
        <path d={`M${b.x1} ${base + 26}v4H${b.x2}v-4`} />
        <text x={(b.x1 + b.x2) / 2} y={base + 45} text-anchor="middle">
          {b.label}
        </text>
      </g>
    ))
  }
</svg>

{albumList && <p class="ch-note">Los discos nuevos son {albumList}.</p>}

<details class="ch-data">
  <summary>Ver datos</summary>
  <div class="ch-table-wrap">
<table class="ch-table">
  <caption>Canciones por año y por grupo de discos.</caption>
  <thead>
    <tr><th scope="col">Año</th><th scope="col">{GROUPS[0]}</th><th scope="col">{GROUPS[1]}</th><th
        scope="col">Total</th></tr>
  </thead>
  <tbody>
    {
      bars.map((b) => (
        <tr>
          <th scope="row">{b.year}</th>
          <td>{b.owg}</td>
          <td>{b.nuevos}</td>
          <td>{b.total}</td>
        </tr>
      ))
    }
  </tbody>
</table>
  </div>
</details>

<style>
  .bracket path {
    fill: none;
    stroke: var(--ink-soft);
    stroke-opacity: 0.5;
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }

  .bracket text {
    fill: var(--ink-soft);
    font-family: var(--round);
    font-weight: 600;
    font-size: 11px;
  }
</style>
