---
import { MONTHS } from '../lib/format';

const days = Array.from({ length: 31 }, (_, i) => i + 1);
---

<form id="date-form" class="date-form" novalidate>
  <div class="field field--day">
    <label class="eyebrow" for="day-select">Día</label>
    <div class="select">
      <select id="day-select" name="day">
        {days.map((d) => <option value={d}>{String(d).padStart(2, '0')}</option>)}
      </select>
    </div>
  </div>

  <div class="field field--month">
    <label class="eyebrow" for="month-select">Mes</label>
    <div class="select">
      <select id="month-select" name="month">
        {MONTHS.map((name, i) => <option value={i + 1}>{name}</option>)}
      </select>
    </div>
  </div>

  <button type="submit" class="search-btn">
    Buscar <span aria-hidden="true">→</span>
  </button>
</form>

<style>
  .date-form {
    display: grid;
    grid-template-columns: 6.25rem 1fr;
    gap: 14px 12px;
    align-items: end;
  }

  @media (min-width: 640px) {
    .date-form {
      grid-template-columns: 7rem minmax(12rem, 16rem) auto;
      justify-content: start;
      gap: 16px;
    }
  }

  .field {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .select {
    position: relative;
  }

  /* chevron */
  .select::after {
    content: '';
    position: absolute;
    right: 18px;
    top: 50%;
    width: 6px;
    height: 6px;
    border-right: 1.5px solid var(--ink-soft);
    border-bottom: 1.5px solid var(--ink-soft);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  select {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    height: 56px;
    padding: 0 40px 0 16px;
    font-family: var(--mono);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--ink);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 8px;
    cursor: pointer;
    transition:
      border-color 160ms var(--ease),
      box-shadow 160ms var(--ease);
  }

  select:hover {
    border-color: #3d352b;
  }

  select:focus-visible {
    outline: 2px solid transparent;
    outline-offset: 2px;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .search-btn {
    grid-column: 1 / -1;
    height: 56px;
    padding: 0 28px;
    font-family: var(--mono);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--bg);
    background: var(--ink);
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 3px 0 0 var(--accent);
    transition:
      transform 120ms var(--ease),
      box-shadow 120ms var(--ease),
      background-color 160ms var(--ease);
  }

  @media (min-width: 640px) {
    .search-btn {
      grid-column: auto;
    }
  }

  .search-btn span {
    display: inline-block;
    margin-left: 6px;
    transition: transform 160ms var(--ease);
  }

  @media (hover: hover) {
    .search-btn:hover {
      background: #fff6e6;
    }
    .search-btn:hover span {
      transform: translateX(3px);
    }
  }

  .search-btn:active {
    transform: translateY(3px);
    box-shadow: 0 0 0 0 var(--accent);
  }

  .search-btn:focus-visible {
    outline: 2px solid transparent;
    outline-offset: 2px;
    box-shadow:
      0 3px 0 0 var(--accent),
      0 0 0 3px var(--bg),
      0 0 0 5px var(--accent);
  }
</style>
