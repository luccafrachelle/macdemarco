---
import Base from '../layouts/Base.astro';
import DateInput from '../components/DateInput.astro';
import ResultCard from '../components/ResultCard.astro';
import CalendarGrid from '../components/CalendarGrid.astro';
import db from '../data/songs.json';
import { countCoveredDays } from '../lib/format';
import type { DB } from '../lib/types';

const data = db as DB;
const covered = countCoveredDays(data);
// Escape "<" so a title can never close the <script> element.
const dbJson = JSON.stringify(data).replace(/</g, '\\u003c');
---

<Base>
  <main class="container page">
    <header class="hero">
      <h1 class="display">
        ¿Hay alguna canción de Mac DeMarco en <em class="hero__mark"
          >tu&nbsp;cumple<svg
            class="hero__stroke"
            viewBox="0 0 240 14"
            preserveAspectRatio="none"
            aria-hidden="true"
            focusable="false"
            ><path
              pathLength="1"
              d="M3 9.5c18-2.6 41-4.4 66-3.6 21 .7 33 2.9 55 2.4 30-.7 52-4.8 77-4.9 14 0 27 1.2 36 2.9"
            /></svg
          ></em
        >?
      </h1>
      <p class="lede hero__lede">Poné la fecha de tu cumple y fijate si hay alguna canción ese día o cerca.</p>
    </header>

    <section class="search" aria-label="Buscar por fecha de cumpleaños">
      <DateInput />
    </section>

    <section class="result-section" aria-label="Resultado">
      <ResultCard />
    </section>

    <CalendarGrid />
  </main>

  <footer class="container site-footer">
    <p class="site-footer__data">
      <span>{covered} de 366 días tienen canción</span>
      <span class="site-footer__sep" aria-hidden="true">·</span>
      <span>datos de MusicBrainz y ListenBrainz</span>
    </p>
    <p class="site-footer__note">Esto es una sidequest, claramente no es oficial. Un saludo.</p>
  </footer>

  <script type="application/json" id="db" set:html={dbJson} />
  <script>
    import '../scripts/app.ts';
  </script>
</Base>

<style>
  .page {
    display: grid;
    gap: 48px;
    padding-top: clamp(32px, 7vw, 72px);
    padding-bottom: 72px;
  }

  @media (min-width: 720px) {
    .page {
      gap: 72px;
    }
  }

  .hero {
    display: grid;
    gap: 24px;
    max-width: min(100%, 820px);
  }


  /* "tu cumple": yellow italic with one thin hand-drawn stroke under it */
  .hero__mark {
    position: relative;
    display: inline-block;
    padding-bottom: 0.06em;
  }

  .hero__stroke {
    position: absolute;
    left: -0.02em;
    right: -0.06em;
    bottom: -0.08em;
    width: calc(100% + 0.08em);
    height: 0.2em;
    overflow: visible;
  }

  .hero__stroke path {
    fill: none;
    stroke: var(--yellow);
    stroke-width: 1.5px;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: draw 1100ms 250ms var(--ease) both;
  }

  .hero__lede {
    max-width: 46ch;
  }

  .result-section:has(> .result:empty) {
    display: none;
  }

  .site-footer {
    display: grid;
    gap: 6px;
    padding-bottom: 40px;
  }

  .site-footer__data {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .site-footer p {
    font-size: 0.75rem;
    letter-spacing: 0.01em;
    color: var(--ink-soft);
  }

  .site-footer__sep {
    opacity: 0.5;
  }
</style>
