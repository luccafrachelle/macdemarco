---
import Base from '../layouts/Base.astro';
import DateInput from '../components/DateInput.astro';
import ResultCard from '../components/ResultCard.astro';
import CalendarGrid from '../components/CalendarGrid.astro';
import db from '../data/songs.json';
import { countCoveredDays } from '../lib/format';
import type { DB } from '../lib/types';

const data = db as DB;
const covered = countCoveredDays(data);
// Escape "<" so a title can never close the <script> element.
const dbJson = JSON.stringify(data).replace(/</g, '\\u003c');
---

<Base>
  <main class="container page">
    <header class="hero">
      <p class="eyebrow hero__eyebrow">
        <span class="hero__rec" aria-hidden="true"></span>
        mac demarco · demos con fecha
      </p>
      <h1 class="display">¿Hay una canción de Mac para <em>tu&nbsp;cumple</em>?</h1>
      <p class="lede hero__lede">
        Mac le puso de nombre la fecha a un montón de demos: <i>One Wayne G</i> y los discos que vinieron
        después. Elegí tu día y fijate.
      </p>
    </header>

    <section class="search" aria-label="Buscar por fecha de cumpleaños">
      <DateInput />
    </section>

    <section class="result-section" aria-label="Resultado">
      <ResultCard />
    </section>

    <CalendarGrid />
  </main>

  <footer class="container site-footer">
    <p>
      <span>{covered} de 366 días tienen canción</span>
      <span class="site-footer__sep" aria-hidden="true">·</span>
      <span>datos de MusicBrainz y ListenBrainz</span>
      <span class="site-footer__sep" aria-hidden="true">·</span>
      <span>lo hizo un fan, no es oficial</span>
    </p>
  </footer>

  <script type="application/json" id="db" set:html={dbJson} />
  <script>
    import '../scripts/app.ts';
  </script>
</Base>

<style>
  .page {
    display: grid;
    gap: 40px;
    padding-top: clamp(48px, 10vw, 112px);
    padding-bottom: 64px;
  }

  @media (min-width: 720px) {
    .page {
      gap: 64px;
    }
  }

  .hero {
    display: grid;
    gap: 20px;
    max-width: min(100%, 760px);
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  /* little REC light */
  .hero__rec {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .hero__lede {
    max-width: 52ch;
  }

  .hero__lede i {
    font-style: normal;
    color: var(--ink);
  }

  .result-section:has(> .result:empty) {
    display: none;
  }

  .site-footer {
    padding-bottom: 40px;
  }

  .site-footer p {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    letter-spacing: 0.01em;
    color: var(--ink-soft);
  }

  .site-footer__sep {
    opacity: 0.45;
  }

  @media (max-width: 639.98px) {
    .site-footer p {
      flex-direction: column;
    }
    .site-footer__sep {
      display: none;
    }
  }
</style>
